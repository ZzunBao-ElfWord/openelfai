# Langfuse 自托管环境变量。复制为 .env 后逐项填写。
# 生成随机值：openssl rand -hex 32

# ---- 数据库/中间件密钥（必填）----
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_AUTH=
SALT=
ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# ---- Web 控制台 ----
# 本机端口，默认 3100；外网访问请走 nginx 反代
LANGFUSE_WEB_PORT=3100
NEXTAUTH_URL=http://localhost:3100

# ---- 首次启动自动初始化（必填，填好后注释掉也不影响后续启动）----
LANGFUSE_INIT_USER_EMAIL=admin@openelfai.com
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=
# 服务端 API 密钥对：生成后同步到 openelfai server 的环境变量
# LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY / LANGFUSE_BASE_URL=http://127.0.0.1:3100
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-
