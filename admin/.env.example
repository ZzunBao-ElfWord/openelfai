# ===== OpenElf 管理后台 BFF 环境变量模板 =====
# 复制为 .env 使用；.env 绝不入库。密钥生成：openssl rand -hex 32

# 监听地址（仅本机回源，由 nginx 反代暴露）
PORT=8094
LISTEN_HOST=127.0.0.1

# MySQL 数据源（账号 deploy/mysql-admin-init.sql 创建；库名按实际部署修改）
MYSQL_DSN=openelf_admin:<CHANGE_ME>@tcp(127.0.0.1:3306)/openelf?charset=utf8mb4&parseTime=true&loc=UTC&timeout=5s

# JWT 签发密钥与有效期
JWT_SECRET=<CHANGE_ME_随机64位十六进制>
JWT_TTL_HOURS=12

# 登录/访问来源 IP 白名单（逗号分隔；留空 = 不限制）
ALLOWED_IPS=

# 允许跨域来源（逗号分隔；生产同源部署可留空）
CORS_ORIGINS=

# 首次启动种子超管：仅当 admin_users 为空时生效；登录后请立即清空这两项
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Node 业务 API 健康检查地址（/api/v1/system/health 探测用）
NODE_API_HEALTH_URL=http://127.0.0.1:8787/api/v1/health

# 运营素材落盘目录（官方 AI 形象 / 栏目封面）；需对运行用户可写
ASSETS_DIR=/var/lib/openelf-admin/assets

# ===== 形象工坊（代理到 openelf-api 内部运营接口 /internal/ops/character）=====
# 内部运营接口地址（默认本机 8787）
OPS_API_BASE_URL=http://127.0.0.1:8787
# 内部运营接口令牌，必须与 openelf-api 的 OPS_TOKEN 一致；留空则形象工坊整体不可用（503 OPS_DISABLED）
OPS_TOKEN=
# 形象图片/联系表外链前缀，浏览器直接访问；不填时默认等于 OPS_API_BASE_URL
# 图片由 openelf-api 的 /api/v1/character-assets/:file 提供，后台与 API 不同域时填公网地址
# OPS_ASSET_BASE_URL=http://127.0.0.1:8787
