# Put real values only in /etc/openelf-auth.env on the server (chmod 600).
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=精灵跳动
ALIYUN_SMS_TEMPLATE_CODE=SMS_512060716
# Generate a random 32+ byte secret; keep it unchanged across restarts.
AUTH_HMAC_SECRET=
AUTH_DATA_FILE=/var/lib/openelf-auth/state.json
AUTH_HOST=127.0.0.1
AUTH_PORT=8787
# iOS IAP remains disabled until product IDs, server wallet, and Apple keys are reviewed.
APPLE_IAP_ENABLED=false
APPLE_WALLET_AUTHORITY_READY=false
APPLE_IAP_PRODUCTS_JSON={}
APPLE_IAP_BUNDLE_ID=com.ai.openelf
APPLE_IAP_APP_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY_PATH=
APPLE_IAP_ROOT_CERT_PATHS=
APPLE_IAP_ALLOW_SANDBOX=false
