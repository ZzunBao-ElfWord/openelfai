# Add/update only APPLE_IAP_* entries in /etc/openelf-api.env.
# Keep existing database, login, SMS and captcha settings.
# Remain disabled until deployment, wallet integration and sandbox tests complete.
APPLE_IAP_ENABLED=false
APPLE_IAP_SANDBOX_ONLY=false
APPLE_IAP_PRODUCTS_JSON={"com.ai.openelf.gems7":7,"com.ai.openelf.gems42":42,"com.ai.openelf.gems210":210,"com.ai.openelf.gems476":476,"com.ai.openelf.gems896":896,"com.ai.openelf.gems2086":2086}
APPLE_IAP_BUNDLE_ID=com.ai.openelf
APPLE_IAP_APP_ID=6761752635
APPLE_IAP_KEY_ID=P245X949C7
APPLE_IAP_ISSUER_ID=80036682-0187-4edb-a806-6ec801ce09e1
APPLE_IAP_PRIVATE_KEY_PATH=/etc/openelf/keys/SubscriptionKey_P245X949C7.p8
# Apple root certificate file paths; configure after installing certificates.
APPLE_IAP_ROOT_CERT_PATHS=/etc/openelf/certs/AppleRootCA-G3.cer
APPLE_IAP_ALLOW_SANDBOX=false

# —— 审核与合规（写入 /etc/openelf-api.env） ——
# 审核专用登录账号，格式 手机号:验证码，多个用逗号分隔。
# 该验证码可重复登录，仅供应用商店/支付渠道审核人员使用，上线前确认只配必要的账号。
REVIEW_LOGIN_ACCOUNTS=13800000000:123456
# 审核账号每天首次登录自动补足的钻石上限（0 表示不预置），便于审核员体验打赏与购买。
REVIEW_SEED_DIAMONDS=1000
# 举报复核队列令牌（GET/POST /internal/reports，需带 X-Review-Token 头）。
# 留空则内部审核接口直接返回 404；请生成 32 位以上随机串并妥善保管。
COMPLIANCE_REVIEW_TOKEN=
