# Merge these values into the existing private server environment file.
# Prefer a dedicated RAM identity with only CloudAuth permissions.
ALIYUN_CLOUDAUTH_ENABLED=true
ALIYUN_CLOUDAUTH_ACCESS_KEY_ID=
ALIYUN_CLOUDAUTH_ACCESS_KEY_SECRET=
ALIYUN_CLOUDAUTH_ENDPOINT=cloudauth.aliyuncs.com
ALIYUN_CLOUDAUTH_REGION_ID=cn-hangzhou
