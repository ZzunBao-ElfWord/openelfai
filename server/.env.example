# OpenElf 业务 API 环境变量模板
#
# 用法：复制为 /etc/openelf-api.env（线上）或本地 .env，再按需填写。
# 铁律：密钥只存在于服务器环境文件，禁止提交到仓库、打进 Flutter assets 或写进日志。
# 分片样例：.env.alipay.example、.env.captcha.example、.env.apple.example。

# —— 基础 ——
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
TRUST_PROXY=true
LOG_LEVEL=info

# —— 数据库（必填） ——
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=openelf
DB_PASSWORD=
DB_NAME=openelf
DB_POOL_SIZE=10

# —— 鉴权密钥（必填，≥16 字符；生成后不得随意更换） ——
JWT_SECRET=
SMS_CODE_PEPPER=
REFRESH_TOKEN_PEPPER=
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=2592000

# —— 形象工坊（P0/P1） ——
# 运营内部接口 x-ops-token，未配置则 /internal/ops/* 全部返回 503；需与后台 .env 的 OPS_TOKEN 一致
OPS_TOKEN=
# 形象精修模型（OpenAI 风格 images/generations）；未配置则跳过精修，仅本地合成
CHARACTER_REFINE_URL=
CHARACTER_REFINE_MODEL=
# 形象图片目录默认 server/assets/characters；线上 systemd 需加
# ReadWritePaths=/opt/openelf-api/assets/characters，否则 ProtectSystem=strict 会 EROFS

# —— UGC 角色铸造（KOKO LinkSprite 链服务，context-path=/api，鉴权头 X-API-Key） ——
# 两项未配置时铸造接口返回 503 CHAIN_DISABLED，绝不伪造任何链上凭证。
LINKSPRITE_BASE_URL=https://nft.kokokongkong.com/api
LINKSPRITE_API_KEY=
# tokenURI / 元数据里使用的公网资源前缀（必须可被外部访问）
CHARACTER_PUBLIC_ASSET_BASE=https://openelfai.com
# UGC 铸造前授权登记使用的 IP 方地址；未配置时回退 PLATFORM_TREASURY_ADDRESS，
# 两者都为空时铸造接口返回 503 IP_OWNER_NOT_CONFIGURED
PLATFORM_IP_OWNER_ADDRESS=
# P4 系列（B2B）铸造的接收地址；未配置时 /internal/ops/character/series/:id/mint 返回 503 TREASURY_NOT_CONFIGURED
PLATFORM_TREASURY_ADDRESS=

# —— 短信登录 ——
SMS_PROVIDER=aliyun
AUTH_DEBUG_CODES=false
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 审核/演示账号：手机号:验证码，逗号分隔；未配置则关闭
REVIEW_LOGIN_ACCOUNTS=
REVIEW_SEED_DIAMONDS=1000
SMS_WHITELIST_PHONES=
SMS_WHITELIST_CODE=

# —— 图形验证码 ——
ALIYUN_CAPTCHA_ENABLED=false
ALIYUN_CAPTCHA_ALLOW_ON_ERROR=true
ALIYUN_CAPTCHA_ENDPOINT=https://captcha.alicaptcha.com/validate
ALIYUN_CAPTCHA_TIMEOUT_MS=8000
ALIYUN_CAPTCHA_WEB_APP_ID=
ALIYUN_CAPTCHA_WEB_APP_KEY=
ALIYUN_CAPTCHA_ANDROID_APP_ID=
ALIYUN_CAPTCHA_ANDROID_APP_KEY=
ALIYUN_CAPTCHA_IOS_APP_ID=
ALIYUN_CAPTCHA_IOS_APP_KEY=
# enforce（默认，必须带阿里云 H5 证明）；off 仅限用户明确批准的维护操作
WEB_CAPTCHA_MODE=enforce

# —— 实名核验（阿里云实人认证，复用 ALIYUN_ACCESS_KEY_ID/SECRET） ——
REALNAME_VERIFY_ENABLED=true
REALNAME_MODE=ocr
REALNAME_ENDPOINT=cloudauth.aliyuncs.com
REALNAME_TIMEOUT_MS=20000
REALNAME_MAX_FAILURES=5
REALNAME_LOCK_HOURS=24

# —— 内部审核/运维接口令牌（不配置则对应接口整体关闭） ——
COMPLIANCE_REVIEW_TOKEN=
WITHDRAW_REVIEW_TOKEN=
# 生产必填；未配置时回落到 dev-internal-secret
INTERNAL_CALLBACK_SECRET=

# —— 支付宝（App 充值 + 平台充值） ——
ALIPAY_ENABLED=false
ALIPAY_SANDBOX=false
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
# public（PEM 公钥模式）| certificate（证书模式）
ALIPAY_KEY_MODE=public
ALIPAY_PRIVATE_KEY_PATH=/etc/openelf/keys/alipay-app-private.pem
ALIPAY_PUBLIC_KEY_PATH=/etc/openelf/keys/alipay-public.pem
ALIPAY_APP_CERT_PATH=
ALIPAY_PUBLIC_CERT_PATH=
ALIPAY_ROOT_CERT_PATH=
ALIPAY_NOTIFY_URL=https://openelfai.com/api/v1/android/alipay/notify
ALIPAY_TOPUP_NOTIFY_URL=
ALIPAY_TOPUP_RETURN_URL=
ANDROID_COMMERCE_ENABLED=false

# —— Apple IAP（细节见 docs/apple-iap-setup.md） ——
APPLE_IAP_ENABLED=false
APPLE_IAP_SANDBOX_ONLY=false
APPLE_IAP_ALLOW_SANDBOX=false
APPLE_IAP_BUNDLE_ID=com.ai.openelf
APPLE_IAP_APP_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY_PATH=
APPLE_IAP_ROOT_CERT_PATHS=
APPLE_IAP_PRODUCTS_JSON={}

# —— 开放平台 / 模型网关 ——
# 强化密钥：用于 User API Key 与厂商凭据的 AES-256-GCM 加密，base64 编码 32 字节。
# 注意：一旦已有密文入库，此值不可再变更，否则历史密文全部无法解密。
PLATFORM_SECRETS_KEY=
# 未配置 PLATFORM_SECRETS_KEY 时的兜底派生盐
PLATFORM_KEY_PEPPER=
PLATFORM_CHAT_MODEL=deepseek/deepseek-chat
PLATFORM_CORS_ORIGINS=https://openelfai.com,https://www.openelfai.com
PLATFORM_SELF_URL=http://127.0.0.1:8787
PLATFORM_FALLBACK_REPLY=
PLATFORM_FILTERED_REPLY=

# —— 开发者技能沙箱 ——
DEV_SANDBOX_RUNNER=
DEV_SANDBOX_ENDPOINT=
DEV_SANDBOX_TOKEN=
DEV_MAX_DAILY_RUNS=

# —— 官方 AI 账号自动运营 ——
WORLD_AGENTS_ENABLED=true
WORLD_AGENTS_DAILY=24
WORLD_AGENTS_MAX_PER_CYCLE=3
WORLD_AGENTS_FAILURE_COOLDOWN_MS=1800000
# 密钥直接写在 /opt/litellm/.env、未走后台配置的厂商（逗号分隔）
WORLD_AGENTS_VENDORS=
WORLD_ASSET_BASE_URL=https://openelfai.com

# —— 世界对话（访客与别人的 AI 纯对话，费用由持有人承担） ——
# 单访客对单只 AI 的每日消息上限（按服务器本地自然日结算）
WORLD_CHAT_VISITOR_DAILY_LIMIT=20
# 单只 AI 的世界对话每日成本预算（micro，1 元 = 1,000,000 micro），超额后访客只得固定话术
WORLD_CHAT_ELF_DAILY_BUDGET_MICRO=2000000
# token → micro 折算率：每 1K tokens 计多少 micro（世界对话与平台推理计量共用同一折算）
WORLD_CHAT_MICRO_PER_1K_TOKENS=2000
# 上游响应缺 usage 时按每条消息估算的 token 数
WORLD_CHAT_EST_TOKENS_PER_MSG=1500

# —— 平台推理成本与内容质量 ——
# 单精灵日成本告警线（micro）：当日总成本 / 当日活跃精灵数超过该值时 ops 接口记 warn 日志（缺省 80000 = 0.08 元）
ELF_COST_WARN_MICRO=80000
# 信息流「空话」过滤阈值（0..1）：scoreWorldPost 低于该值的帖子不进 recommend/hot 排序与视频流；mine 排序不过滤
QUALITY_FEED_MIN=0.35

# —— 官方 AI 视频生成（方舟） ——
WORLD_VIDEOS_ENABLED=false
WORLD_VIDEOS_PER_DAY=3
WORLD_VIDEOS_DURATION=12
WORLD_VIDEOS_MODEL=doubao-seedance-2-0-260128
WORLD_VIDEOS_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
WORLD_VIDEOS_CAPTION_MODEL=doubao/llama-3-70b
WORLD_VIDEOS_IMAGE_URL=
WORLD_VIDEOS_SLOTS=9,15,21
WORLD_VIDEOS_FAILURE_COOLDOWN_MS=1800000
VOLCENGINE_API_KEY=
ARK_API_KEY=

# —— 视频剪辑连接器（/mcp/video） ——
# 需要服务器已安装 ffmpeg 与 ffprobe；转写不配置时技能只能走手动 segments。
VIDEO_MCP_ENABLED=true
VIDEO_MCP_WORK_DIR=
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
# openai=OpenAI 兼容 /audio/transcriptions；dashscope=阿里云百炼异步文件转写（带句级时间戳）
# 未显式配置 ASR_PROVIDER 时按模型名与域名自动判定
ASR_PROVIDER=dashscope
ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ASR_API_KEY=
ASR_MODEL=qwen-audio-3.1-asr-flash-filetrans
# 异步任务排队 + 处理的总时长上限；nginx 对 /mcp/video 已放宽到 600s
ASR_TIMEOUT_MS=480000
VIDEO_MAX_SOURCE_BYTES=209715200
VIDEO_MAX_SOURCE_SEC=1800
VIDEO_DOWNLOAD_TIMEOUT_MS=300000
VIDEO_FFMPEG_TIMEOUT_MS=300000

# —— 入向 MCP（用户自带的外部 MCP Server，对话中由精灵调用其工具） ——
# 生产必须保持 false；开启后允许指向 127.0.0.1/私网，仅供本地联调。
INBOUND_MCP_ALLOW_PRIVATE_HOSTS=false
INBOUND_MCP_TIMEOUT_MS=15000

# —— 精灵记忆（平台买单的事实抽取） ——
ELF_MEMORY_ENABLED=true
ELF_MEMORY_MODEL=deepseek/deepseek-chat
ELF_MEMORY_MAX_FACTS_PER_PAIR=50
ELF_MEMORY_RECALL_TOP_N=5
ELF_MEMORY_RECALL_MAX_CHARS=600
ELF_MEMORY_DAILY_EXTRACT_PER_ELF=100
ELF_MEMORY_EXTRACT_MIN_CHARS=4

# —— 媒体能力：语音合成（OpenAI 兼容 /v1/audio/speech） ——
# 未配置 baseUrl 或 apiKey 时 /api/v1/media/tts 返回「未启用」。
TTS_ENABLED=false
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=alloy
TTS_MAX_CHARS=1000
TTS_DAILY_LIMIT=50
TTS_TIMEOUT_MS=60000

# —— 媒体能力：ComfyUI 出图 ——
# 未配置 baseUrl 时 /api/v1/media/image 返回「未启用」；ComfyUI 通常自建内网，故不做内网拦截。
COMFY_ENABLED=false
COMFY_BASE_URL=
# 默认 SDXL 工作流使用的 checkpoint 文件名（与 ComfyUI 的 models/checkpoints 一致）
COMFY_CHECKPOINT=
# 自定义 API 格式 workflow（可选）；留空使用内置 SDXL 文生图模板
COMFY_WORKFLOW_PATH=
COMFY_TIMEOUT_MS=180000
COMFY_POLL_MS=1500
COMFY_DAILY_LIMIT=100

# —— Civitai 资源库（搜索 → 收藏 → 出图引用 LoRA） ——
# 平台不代下载模型权重：收藏后由运维把对应文件放到 ComfyUI 的 models/loras。
CIVITAI_ENABLED=true
CIVITAI_DAILY_SEARCH_LIMIT=200

# —— LLM 可观测（Langfuse 自托管，见 deploy/langfuse） ——
# 两项密钥留空即整体关闭，业务链路零影响。
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://127.0.0.1:3100
LANGFUSE_ENVIRONMENT=
