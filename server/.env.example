# OpenElf 业务 API 环境变量模板
#
# 用法：复制为 /etc/openelf-api.env（线上）或本地 .env，再按需填写。
# 铁律：密钥只存在于服务器环境文件，禁止提交到仓库、打进 Flutter assets 或写进日志。
# 分片样例：.env.alipay.example、.env.captcha.example、.env.apple.example。

# —— 基础 ——
NODE_ENV=production
HOST=127.0.0.1
PORT=8787
TRUST_PROXY=true
LOG_LEVEL=info

# —— 数据库（必填） ——
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=openelf
DB_PASSWORD=
DB_NAME=openelf
DB_POOL_SIZE=10

# —— 鉴权密钥（必填，≥16 字符；生成后不得随意更换） ——
JWT_SECRET=
SMS_CODE_PEPPER=
REFRESH_TOKEN_PEPPER=
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=2592000

# —— 形象工坊（P0/P1） ——
# 运营内部接口 x-ops-token，未配置则 /internal/ops/* 全部返回 503；需与后台 .env 的 OPS_TOKEN 一致
OPS_TOKEN=
# 形象精修模型（OpenAI 风格 images/generations）；未配置则跳过精修，仅本地合成
CHARACTER_REFINE_URL=
CHARACTER_REFINE_MODEL=
# 形象图片目录默认 server/assets/characters；线上 systemd 需加
# ReadWritePaths=/opt/openelf-api/assets/characters，否则 ProtectSystem=strict 会 EROFS

# —— 短信登录 ——
SMS_PROVIDER=aliyun
AUTH_DEBUG_CODES=false
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 审核/演示账号：手机号:验证码，逗号分隔；未配置则关闭
REVIEW_LOGIN_ACCOUNTS=
REVIEW_SEED_DIAMONDS=1000
SMS_WHITELIST_PHONES=
SMS_WHITELIST_CODE=

# —— 图形验证码 ——
ALIYUN_CAPTCHA_ENABLED=false
ALIYUN_CAPTCHA_ALLOW_ON_ERROR=true
ALIYUN_CAPTCHA_ENDPOINT=https://captcha.alicaptcha.com/validate
ALIYUN_CAPTCHA_TIMEOUT_MS=8000
ALIYUN_CAPTCHA_WEB_APP_ID=
ALIYUN_CAPTCHA_WEB_APP_KEY=
ALIYUN_CAPTCHA_ANDROID_APP_ID=
ALIYUN_CAPTCHA_ANDROID_APP_KEY=
ALIYUN_CAPTCHA_IOS_APP_ID=
ALIYUN_CAPTCHA_IOS_APP_KEY=
# enforce（默认，必须带阿里云 H5 证明）；off 仅限用户明确批准的维护操作
WEB_CAPTCHA_MODE=enforce

# —— 实名核验（阿里云实人认证，复用 ALIYUN_ACCESS_KEY_ID/SECRET） ——
REALNAME_VERIFY_ENABLED=true
REALNAME_MODE=ocr
REALNAME_ENDPOINT=cloudauth.aliyuncs.com
REALNAME_TIMEOUT_MS=20000
REALNAME_MAX_FAILURES=5
REALNAME_LOCK_HOURS=24

# —— 内部审核/运维接口令牌（不配置则对应接口整体关闭） ——
COMPLIANCE_REVIEW_TOKEN=
WITHDRAW_REVIEW_TOKEN=
# 生产必填；未配置时回落到 dev-internal-secret
INTERNAL_CALLBACK_SECRET=

# —— 支付宝（App 充值 + 平台充值） ——
ALIPAY_ENABLED=false
ALIPAY_SANDBOX=false
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
# public（PEM 公钥模式）| certificate（证书模式）
ALIPAY_KEY_MODE=public
ALIPAY_PRIVATE_KEY_PATH=/etc/openelf/keys/alipay-app-private.pem
ALIPAY_PUBLIC_KEY_PATH=/etc/openelf/keys/alipay-public.pem
ALIPAY_APP_CERT_PATH=
ALIPAY_PUBLIC_CERT_PATH=
ALIPAY_ROOT_CERT_PATH=
ALIPAY_NOTIFY_URL=https://openelfai.com/api/v1/android/alipay/notify
ALIPAY_TOPUP_NOTIFY_URL=
ALIPAY_TOPUP_RETURN_URL=
ANDROID_COMMERCE_ENABLED=false

# —— Apple IAP（细节见 docs/apple-iap-setup.md） ——
APPLE_IAP_ENABLED=false
APPLE_IAP_SANDBOX_ONLY=false
APPLE_IAP_ALLOW_SANDBOX=false
APPLE_IAP_BUNDLE_ID=com.ai.openelf
APPLE_IAP_APP_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_ISSUER_ID=
APPLE_IAP_PRIVATE_KEY_PATH=
APPLE_IAP_ROOT_CERT_PATHS=
APPLE_IAP_PRODUCTS_JSON={}

# —— 开放平台 / 模型网关 ——
# 强化密钥：用于 User API Key 与厂商凭据的 AES-256-GCM 加密，base64 编码 32 字节。
# 注意：一旦已有密文入库，此值不可再变更，否则历史密文全部无法解密。
PLATFORM_SECRETS_KEY=
# 未配置 PLATFORM_SECRETS_KEY 时的兜底派生盐
PLATFORM_KEY_PEPPER=
PLATFORM_CHAT_MODEL=deepseek/deepseek-chat
PLATFORM_CORS_ORIGINS=https://openelfai.com,https://www.openelfai.com
PLATFORM_SELF_URL=http://127.0.0.1:8787
PLATFORM_FALLBACK_REPLY=
PLATFORM_FILTERED_REPLY=

# —— 开发者技能沙箱 ——
DEV_SANDBOX_RUNNER=
DEV_SANDBOX_ENDPOINT=
DEV_SANDBOX_TOKEN=
DEV_MAX_DAILY_RUNS=

# —— 官方 AI 账号自动运营 ——
WORLD_AGENTS_ENABLED=true
WORLD_AGENTS_DAILY=24
WORLD_AGENTS_MAX_PER_CYCLE=3
WORLD_AGENTS_FAILURE_COOLDOWN_MS=1800000
# 密钥直接写在 /opt/litellm/.env、未走后台配置的厂商（逗号分隔）
WORLD_AGENTS_VENDORS=
WORLD_ASSET_BASE_URL=https://openelfai.com

# —— 官方 AI 视频生成（方舟） ——
WORLD_VIDEOS_ENABLED=false
WORLD_VIDEOS_PER_DAY=3
WORLD_VIDEOS_DURATION=12
WORLD_VIDEOS_MODEL=doubao-seedance-2-0-260128
WORLD_VIDEOS_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
WORLD_VIDEOS_CAPTION_MODEL=doubao/llama-3-70b
WORLD_VIDEOS_IMAGE_URL=
WORLD_VIDEOS_SLOTS=9,15,21
WORLD_VIDEOS_FAILURE_COOLDOWN_MS=1800000
VOLCENGINE_API_KEY=
ARK_API_KEY=
